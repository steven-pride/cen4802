pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        timestamps()
    }

    environment {
        KUBECONFIG = 'C:\\Users\\smfpr\\.kube\\config'
        JMETER_HOME = 'C:\\apache-jmeter-5.6.3'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Verify Kubernetes Cluster') {
            steps {
                bat '''
                    kubectl cluster-info --context kind-fibonacci-cluster

                    kubectl wait ^
                        --context kind-fibonacci-cluster ^
                        --for=condition=Ready ^
                        nodes ^
                        --all ^
                        --timeout=180s

                    kubectl get nodes ^
                        --context kind-fibonacci-cluster ^
                        -o wide
                '''
            }
        }

        stage('Verify Local Docker Image') {
            steps {
                script {
                    def imageExists = bat(
                        script: 'docker image inspect fibonacci-app:latest >NUL 2>&1',
                        returnStatus: true
                    )

                    if (imageExists != 0) {
                        error 'Docker image fibonacci-app:latest was not found. Run FibonacciApp-Pipeline first.'
                    }
                }

                bat 'docker images fibonacci-app'
            }
        }

        stage('Load Image into kind') {
            steps {
                bat 'kind load docker-image fibonacci-app:latest --name fibonacci-cluster'
            }
        }

        stage('Apply Kubernetes Manifests') {
            steps {
                bat 'kubectl apply -f k8s\\deployment.yaml'
                bat 'kubectl apply -f k8s\\service.yaml'
            }
        }

        stage('Restart Deployment') {
            steps {
                bat 'kubectl rollout restart deployment fibonacci-app'
                bat 'kubectl rollout status deployment fibonacci-app --timeout=120s'
            }
        }

        stage('Verify Deployment') {
            steps {
                bat 'kubectl --context kind-fibonacci-cluster rollout status deployment/fibonacci-app --timeout=120s'
                bat 'kubectl --context kind-fibonacci-cluster get deployment fibonacci-app'
                bat 'kubectl --context kind-fibonacci-cluster get pods -l app=fibonacci-app -o wide'
                bat 'kubectl --context kind-fibonacci-cluster get service fibonacci-app'
            }
        }

        stage('Performance Test') {
            steps {
                bat '''
                    curl.exe ^
                        --fail ^
                        --silent ^
                        --show-error ^
                        --retry 10 ^
                        --retry-all-errors ^
                        --retry-delay 2 ^
                        "http://127.0.0.1:8085/actuator/health/readiness" >NUL

                    if exist performance-results (
                        rmdir /s /q performance-results
                    )

                    mkdir performance-results

                    call "%JMETER_HOME%\\bin\\jmeter.bat" ^
                        -n ^
                        -t performance\\fibonacci-load-test.jmx ^
                        -l performance-results\\results.jtl ^
                        -j performance-results\\jmeter.log ^
                        -e ^
                        -o performance-results\\dashboard
                '''

                perfReport(
                    sourceDataFiles: 'performance-results/results.jtl',
                    errorUnstableThreshold: 0,
                    errorFailedThreshold: 0,
                    failBuildIfNoResultFile: true
                )
            }

            post {
                always {
                    archiveArtifacts(
                        artifacts: 'performance-results/**',
                        allowEmptyArchive: true
                    )
                }
            }
        }
    }
}